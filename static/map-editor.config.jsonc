// Configuration of the VersaTiles Map Editor on this web server.
// The editor reads this file when it starts, so changes need no rebuild.
// Every field is optional: without it, or with an invalid value, the default is used, and the
// browser console names the invalid field. Comments (// and /* */) are allowed.
{
	// ---- Servers ----------------------------------------------------------------------------

	// Their addresses are absolute, or relative to this file, which the browser resolves: e.g.
	// "/" is the host of the editor, "../geocoder/api" a folder next to the editor's. So this file
	// works under any address, e.g. behind a CDN.

	// The tile server: vector tiles, satellite imagery, symbols (sprites) and fonts (glyphs).
	// It must serve the same as tiles.versatiles.org: Shortbread vector tiles and its assets/.
	// Default: "https://tiles.versatiles.org"
	// "tileServer": "https://tiles.versatiles.org",

	// Whether the vector map shows the landcover of low zoom levels (forests, ice, …). The vector
	// tiles of the tile server must have it, like those of tiles.versatiles.org; turn it off for
	// tiles that do not.
	// Default: true
	// "landcover": true,

	// The geocoder of the address search, with the API of Photon.
	// Default: "https://geocode.versatiles.org/api"
	// "geocoder": "https://geocode.versatiles.org/api",

	// ---- New maps ---------------------------------------------------------------------------

	// What a new map shows when the editor opens it: [west, south, east, north] in degrees.
	// Default: the country of the user (guessed from the time zone, in the EU and the US),
	// else the whole world
	// "startView": [-180, -85, 180, 85],

	// The background of a new map, as in .mapjson files: the builder "osm" (the vector map) or
	// "satellite", and the options of @versatiles/style, e.g. { "theme": "gray" }. Once chosen,
	// it is the map's own background, which shared links keep on every server.
	// Default: { "builder": "osm", "options": {} }
	// "startBackground": { "builder": "osm", "options": {} },

	// The language of the labels of the background map of a new map, unless the starting
	// background sets one: "user" (the language of the browser), "local" (local names) or a
	// language code, e.g. "de".
	// Default: "user"
	// "defaultLanguage": "user",

	// ---- Colors -----------------------------------------------------------------------------

	// Color schemes offered in the color picker, before the predefined ones
	// (bright, muted, okabe-ito, set1, dark2, pastel1). Each id once; a scheme with the id of a
	// predefined one replaces it. Colors as "#rrggbb".
	// Default: none
	// "colorSchemes": [{ "id": "corporate", "name": "Corporate", "colors": ["#003366", "#e30613", "#f5a800"] }],

	// Offer only the color schemes above, not the predefined ones.
	// Default: false
	// "replaceDefaultSchemes": false,

	// The color scheme the color picker offers by default, by its id: one of the schemes above
	// or a predefined one.
	// Default: the first scheme offered
	// "defaultColorScheme": "bright",

	// ---- Fonts ------------------------------------------------------------------------------

	// Font faces offered first for labels, by their glyph names on the tile server, e.g.
	// "lato_bold". Faces the tile server does not have are skipped, with a warning in the
	// browser console.
	// Default: none (all faces of the tile server are offered)
	// "fonts": ["open_sans_regular", "open_sans_bold"],

	// Offer only the fonts above.
	// Default: false
	// "replaceDefaultFonts": false
}
