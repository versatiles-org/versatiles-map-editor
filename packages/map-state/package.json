{
  "name": "@versatiles/map-state",
  "version": "1.0.0",
  "description": "Encode and decode maps of the VersaTiles map editor: as compact URL hash, GeoJSON and KML.",
  "license": "MIT",
  "author": "Michael Kreil <versatiles@michael-kreil.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/versatiles-map-editor.git",
    "directory": "packages/map-state"
  },
  "homepage": "https://github.com/versatiles-org/versatiles-map-editor/tree/main/packages/map-state#readme",
  "keywords": [
    "versatiles",
