{
	"$schema": "https://versatiles.org/versatiles-map-editor/schema/mapjson-1.schema.json",
	"map": {
		"center": [139.739, 35.6746],
		"radius": 8996
	},
	"meta": {
		"title": "東京の主要駅"
	},
	"elements": [
		{
			"type": "marker",
			"point": [139.7671, 35.6812],
			"style": {
				"color": "#0072b2",
				"label": "東京駅"
			},
			"popup": {
				"text": "東京駅\n千代田区丸の内一丁目\n赤レンガの駅舎は1914年に完成しました"
			}
		},
		{
			"type": "marker",
			"point": [139.7006, 35.6896],
			"style": {
				"color": "#0072b2",
				"label": "新宿駅"
			},
			"popup": {
				"text": "新宿駅\n新宿区新宿三丁目\n1日の乗降客数が世界一の駅です"
			}
		},
		{
			"type": "marker",
			"point": [139.7016, 35.658],
			"style": {
				"color": "#0072b2",
