{
	// The Playwright tests run in Node.js and are not part of the SvelteKit app, which svelte-check
	// covers. Checked by "npm run check-types".
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		// The package from its source, as the app has it (see tsconfig.json and vite.config.ts): its
		// dist is not built in a fresh checkout, e.g. when a release is tested.
		"paths": { "@versatiles/map-state": ["../packages/map-state/src/index.ts"] }
	},
	"include": ["**/*.ts", "../playwright.config.ts"]
}
