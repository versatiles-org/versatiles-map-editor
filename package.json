{
  "name": "versatiles-map-editor",
  "version": "0.1.0",
  "description": "Standalone, embeddable map editor for VersaTiles.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run test && npm run format:check",
    "dev": "vite dev",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color .",
    "preview": "vite preview",
    "test-coverage": "vitest run --coverage",
    "test-playwright": "playwright test",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "prepare": "husky",
    "upgrade": "npm-check-updates -u; rm -r node_modules; rm package-lock.json; npm install"
  },
  "dependencies": {
    "@versatiles/style": "^5.13.1",
    "maplibre-gl": "^6.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "geojson": "^0.5.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.0.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.102.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "svelte-preprocess": true
  }
}
