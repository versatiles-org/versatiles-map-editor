{
  "name": "versatiles-map-editor",
  "version": "0.1.0",
  "description": "Standalone, embeddable map editor for VersaTiles.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run test && npm run format:check",
    "dev": "vite dev",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color .",
    "preview": "vite preview",
    "test-coverage": "vitest run --coverage",
    "test-playwright": "playwright test",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "prepare": "husky",
    "upgrade": "npm-check-updates -u; rm -r node_modules; rm package-lock.json; npm install"
  },
  "dependencies": {
    "@versatiles/style": "^5.12.1",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@turf/turf": "^7.3.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "geojson": "^0.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^22.2.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "sass-embedded": "^1.100.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.5.0",
    "svelte-preprocess": "^6.0.5",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "cookie": "^0.7.0"
  }
}
