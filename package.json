{
  "name": "versatiles-map-editor",
  "version": "3.1.1",
  "description": "Standalone, embeddable map editor for VersaTiles.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run check-types && vite build",
    "check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p playwright-tests",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run build --workspaces && npm run test && npm run format:check",
    "dev": "vite dev",
    "doc": "npm run doc-graph && npm run doc-bundle",
    "doc-bundle": "scripts/doc_bundle.sh",
    "doc-graph": "svelte-kit sync && vrt deps-graph --svg docs/dependency-graph.svg | vrt doc-insert README.md '### Dependency Graph' && prettier --write --log-level warn README.md",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color . && stylelint --color \"**/*.{css,scss,svelte}\"",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "test-coverage": "vitest run --coverage --testTimeout 10000",
    "test-playwright": "playwright test",
    "test-playwright-all": "ALL_TESTS=1 playwright test",
    "test-playwright-docker": "./scripts/test_playwright_docker.sh",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "upgrade": "vrt deps-upgrade"
  },
  "dependencies": {
    "@versatiles/style": "^6.3.0",
    "maplibre-gl": "^6.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@versatiles/release-tool": "^2.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "npm-check-updates": "^23.1.0",
    "playwright": "^1.63.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  }
}
