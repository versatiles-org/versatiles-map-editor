{
  "name": "versatiles-map-editor",
  "version": "0.1.0",
  "description": "Standalone, embeddable map editor for VersaTiles.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run test && npm run format:check",
    "dev": "vite dev",
    "doc": "npm run doc-graph && npm run doc-bundle && prettier --write --log-level warn README.md",
    "doc-bundle": "svelte-kit sync && vite build --sourcemap && vrt bundle-treemap \"$(ls -S build/_app/immutable/nodes/*.js | head -1)\" --depth 3 --min-size 4000 --svg docs/bundle-treemap.svg | vrt doc-insert README.md '### Bundle Composition'",
    "doc-graph": "vrt deps-graph --svg docs/dependency-graph.svg | vrt doc-insert README.md '### Dependency Graph'",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color .",
    "preview": "vite preview",
    "test-coverage": "vitest run --coverage",
    "test-playwright": "playwright test",
    "test-playwright-docker": "./scripts/test_playwright_docker.sh",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "prepare": "husky",
    "upgrade": "vrt deps-upgrade"
  },
  "dependencies": {
    "@versatiles/style": "^6.0.1",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.2",
    "@versatiles/release-tool": "^2.17.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "geojson": "^0.5.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "sass-embedded": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "svelte-preprocess": true
  }
}
