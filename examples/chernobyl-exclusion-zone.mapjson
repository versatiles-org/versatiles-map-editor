{
	"$schema": "https://raw.githubusercontent.com/versatiles-org/versatiles-map-editor/main/packages/map-state/schema/mapjson-1.schema.json",
	"map": { "center": [30.175189454575417, 51.39166926981753], "radius": 47169.86443603064 },
	"frame": [29.558, 51.066, 31.0, 51.712],
	"meta": {
		"background": {
			"builder": "satellite",
			"options": {
				"raster": { "brightnessMin": 0.1 },
				"osmOverlay": { "recolor": { "brightness": 0.05, "contrast": 0.9 } }
			}
		},
		"viewer": { "legend": "top-left" },
		"legend": {
			"entries": [
				{
					"type": "polygon",
					"style": { "color": "#d55e00" },
					"strokeStyle": { "visible": false },
					"label": "10 km zone"
				},
				{
					"type": "polygon",
					"style": { "color": "#e69f00" },
					"strokeStyle": { "visible": false },
					"label": "30 km exclusion zone"
				}
			]
		},
		"title": "Chernobyl exclusion zone",
		"labelFont": "noto_sans_bold"
	},
	"elements": [
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 30000,
			"style": { "color": "#e69f0040" },
			"strokeStyle": { "color": "#e69f00", "pattern": 2, "width": 2.5 },
			"popup": { "text": "**30 km exclusion zone**\nEvacuated after the disaster of 26 April 1986." }
		},
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 10000,
			"style": { "color": "#d55e0040" },
			"strokeStyle": { "color": "#d55e00", "width": 2.5 },
			"popup": { "text": "**10 km zone**\nThe most contaminated area around the plant." }
		},
		{
			"type": "marker",
			"point": [30.099, 51.389],
			"style": {
				"color": "#be5400",
				"size": 1.3,
				"symbol": "icons:nuclear",
				"label": "Nuclear power plant",
				"align": 4,
				"labelColor": "#be5400",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Nuclear power plant**\nChernobyl Nuclear Power Plant. Reactor 4 exploded on 26 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.0569, 51.4056],
			"style": {
				"color": "#ffffff",
				"halo": 0.5,
				"symbol": "base:icon-town_hall",
				"label": "Pripyat",
				"labelColor": "#ffffff",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Pripyat**\nBuilt for the workers of the plant. Its about 49,000 inhabitants were evacuated on 27 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.2219, 51.2763],
			"style": {
				"color": "#ffffff",
				"halo": 0.5,
				"symbol": "base:icon-town_hall",
				"label": "Chernobyl",
				"labelColor": "#ffffff",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Chernobyl**\nThe town that gave the plant its name, evacuated in May 1986." }
		},
		{
			"type": "marker",
			"point": [30.7547, 51.5226],
			"style": {
				"color": "#ffffff",
				"halo": 0.5,
				"symbol": "base:icon-town_hall",
				"label": "Slavutych",
				"labelColor": "#ffffff",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Slavutych**\nBuilt after the disaster for the workers of the plant and their families." }
		}
	]
}
