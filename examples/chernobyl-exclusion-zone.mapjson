{
	"$schema": "https://versatiles.org/versatiles-map-editor/schema/mapjson-1.schema.json",
	"meta": {
		"background": { "base": "satellite", "streets": false, "borders": false, "language": "local" },
		"legend": {
			"entries": [
				{
					"type": "area",
					"style": { "color": "#ff710040" },
					"outlineStyle": { "color": "#ff7100", "width": 2.5 },
					"label": "10 km zone"
				},
				{
					"type": "area",
					"style": { "color": "#e69f0040" },
					"outlineStyle": { "color": "#e69f00", "dash": "dotted", "width": 2.5 },
					"label": "30 km exclusion zone"
				}
			],
			"theme": "glass"
		},
		"viewer": { "legend": "top-left" },
		"title": "Chernobyl exclusion zone"
	},
	"elements": [
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 30000,
			"style": { "color": "#e69f0040" },
			"outlineStyle": { "color": "#e69f00", "dash": "dotted", "width": 2.5 },
			"popup": { "text": "**30 km exclusion zone**\nEvacuated after the disaster of 26 April 1986." }
		},
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 10000,
			"style": { "color": "#ff710040" },
			"outlineStyle": { "color": "#ff7100", "width": 2.5 },
			"popup": { "text": "**10 km zone**\nThe most contaminated area around the plant." }
		},
		{
			"type": "marker",
			"point": [30.099, 51.389],
			"label": "Nuclear power plant",
			"style": {
				"color": "#ff4d4d",
				"size": 1.3,
				"labelSize": 1.3,
				"haloWidth": 1.5,
				"symbol": "icons:nuclear",
				"labelPosition": "bottom",
				"labelColor": "#ff4d4d",
				"labelFont": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Nuclear power plant**\nChernobyl Nuclear Power Plant. Reactor 4 exploded on 26 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.0569, 51.4056],
			"label": "Pripyat",
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"labelPosition": "top",
				"labelColor": "#ffc84d",
				"labelFont": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Pripyat**\nBuilt for the workers of the plant. Its about 49,000 inhabitants were evacuated on 27 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.2219, 51.2763],
			"label": "Chernobyl",
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"labelColor": "#ffc84d",
				"labelFont": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Chernobyl**\nThe town that gave the plant its name, evacuated in May 1986." }
		},
		{
			"type": "marker",
			"point": [30.7547, 51.5226],
			"label": "Slavutych",
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"labelColor": "#ffc84d",
				"labelFont": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Slavutych**\nBuilt after the disaster for the workers of the plant and their families." }
		}
	]
}
