{
	"$schema": "https://raw.githubusercontent.com/versatiles-org/versatiles-map-editor/main/packages/map-state/schema/mapjson-1.schema.json",
	"map": { "center": [30.169885911217932, 51.38754207221828], "radius": 46402.365179817505 },
	"meta": {
		"background": {
			"builder": "satellite",
			"options": {
				"osmOverlay": {
					"layers": { "roads": false, "transit": false, "pois": false, "boundaries": false, "markings": false }
				}
			}
		},
		"legend": {
			"entries": [
				{
					"type": "polygon",
					"style": { "color": "#ff710040" },
					"strokeStyle": { "color": "#ff7100", "width": 2.5 },
					"label": "10 km zone"
				},
				{
					"type": "polygon",
					"style": { "color": "#e69f0040" },
					"strokeStyle": { "color": "#e69f00", "dash": 2, "width": 2.5 },
					"label": "30 km exclusion zone"
				}
			],
			"theme": "glass"
		},
		"viewer": { "legend": "top-left" },
		"title": "Chernobyl exclusion zone"
	},
	"elements": [
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 30000,
			"style": { "color": "#e69f0040" },
			"strokeStyle": { "color": "#e69f00", "dash": 2, "width": 2.5 },
			"popup": { "text": "**30 km exclusion zone**\nEvacuated after the disaster of 26 April 1986." }
		},
		{
			"type": "circle",
			"point": [30.099, 51.389],
			"radius": 10000,
			"style": { "color": "#ff710040" },
			"strokeStyle": { "color": "#ff7100", "width": 2.5 },
			"popup": { "text": "**10 km zone**\nThe most contaminated area around the plant." }
		},
		{
			"type": "marker",
			"point": [30.099, 51.389],
			"style": {
				"color": "#ff4d4d",
				"size": 1.3,
				"labelSize": 1.3,
				"halo": 1.5,
				"symbol": "icons:nuclear",
				"label": "Nuclear power plant",
				"align": "bottom",
				"labelColor": "#ff4d4d",
				"font": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Nuclear power plant**\nChernobyl Nuclear Power Plant. Reactor 4 exploded on 26 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.0569, 51.4056],
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"label": "Pripyat",
				"align": "top",
				"labelColor": "#ffc84d",
				"font": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": {
				"text": "**Pripyat**\nBuilt for the workers of the plant. Its about 49,000 inhabitants were evacuated on 27 April 1986."
			}
		},
		{
			"type": "marker",
			"point": [30.2219, 51.2763],
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"label": "Chernobyl",
				"labelColor": "#ffc84d",
				"font": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Chernobyl**\nThe town that gave the plant its name, evacuated in May 1986." }
		},
		{
			"type": "marker",
			"point": [30.7547, 51.5226],
			"style": {
				"color": "#ffc84d",
				"symbol": "base:icon-town_hall",
				"label": "Slavutych",
				"labelColor": "#ffc84d",
				"font": "noto_sans_bold",
				"haloColor": "#000000"
			},
			"popup": { "text": "**Slavutych**\nBuilt after the disaster for the workers of the plant and their families." }
		}
	]
}
